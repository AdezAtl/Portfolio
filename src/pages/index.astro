---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <main class="landing-page">
    <section class="hero-section">
      <div class="wrapper hero-layout">
        <div class="hero-copy">
          <p class="eyebrow">Hello, I’m</p>
          <h1>Abdullah ADESOMI A<br /><span>Web Developer</span></h1>
          <p class="tagline">
            I’m a web designer and developer with a passion for creating beautiful digital products
            that help businesses grow and customers connect with your brand.
          </p>

          <div class="hero-actions">
            <a class="primary-btn" href="mailto:adezalt4336@gmail.com">Resume</a>
            <a class="secondary-btn" href="#contact">Hire Me</a>
          </div>
        </div>

        <div class="hero-visual">
          <div class="portrait-wrap">
            <img src="/assets/portrait.jpg" alt="Abdullah portrait" />
          </div>
        </div>
      </div>
    </section>

    <section class="services-section wrapper">
      <div class="service-card">
        <span class="service-icon">✦</span>
        <h3>Website<br />Development</h3>
        <p>Building responsive websites with modern UX and high-performance front-end code.</p>
      </div>
      <div class="service-card">
        <span class="service-icon">◎</span>
        <h3>Website<br />Design</h3>
        <p>Crafting user-focused interfaces that blend creativity, clarity, and conversion.</p>
      </div>
      <div class="service-card">
        <span class="service-icon">◌</span>
        <h3>Bug<br />Fixing</h3>
        <p>Debugging products and refining code for stable, clean, long-term performance.</p>
      </div>
      <div class="service-card">
        <span class="service-icon">▣</span>
        <h3>Web App<br />Design</h3>
        <p>Turning complex workflows into elegant user experiences and business-friendly tools.</p>
      </div>
    </section>

    <section class="process-section">
      <div class="wrapper process-layout">
        <div class="process-photo">
          <img src="/assets/profile.jpg" alt="Profile image" />
        </div>

        <div class="process-copy">
          <p class="mini-label">Which Services I will provide for you</p>
          <div class="process-item">
            <span class="percent">75%</span>
            <div>
              <h4>Designing Product</h4>
              <p>Creating polished interfaces and intuitive experiences tailored to your audience.</p>
            </div>
          </div>
          <div class="process-item">
            <span class="percent">68%</span>
            <div>
              <h4>Developing Product</h4>
              <p>Turning ideas into scalable and maintainable digital products with clean architecture.</p>
            </div>
          </div>
          <div class="process-item">
            <span class="percent">86%</span>
            <div>
              <h4>Marketing Product</h4>
              <p>Shaping your presence to reach customers and support long-term digital growth.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="portfolio-section wrapper">
      <div class="section-header">
        <p class="mini-label">Portfolio Works</p>
        <h2>Recent Case Studies</h2>
      </div>

      <div class="portfolio-grid">
        <article class="portfolio-card card-feature">
          <div class="portfolio-image">
            <img src="/assets/stock-1.jpg" alt="Portfolio project 1" />
          </div>
          <div class="card-meta">
            <span>Web Design</span>
            <h3>Official Video Editor</h3>
          </div>
        </article>

        <article class="portfolio-card">
          <div class="portfolio-image">
            <img src="/assets/stock-2.jpg" alt="Portfolio project 2" />
          </div>
          <div class="card-meta">
            <span>Branding</span>
            <h3>UI System</h3>
          </div>
        </article>

        <article class="portfolio-card">
          <div class="portfolio-image">
            <img src="/assets/stock-3.jpg" alt="Portfolio project 3" />
          </div>
          <div class="card-meta">
            <span>Product</span>
            <h3>Mobile Experience</h3>
          </div>
        </article>

        <article class="portfolio-card">
          <div class="portfolio-image">
            <img src="/assets/stock-4.jpg" alt="Portfolio project 4" />
          </div>
          <div class="card-meta">
            <span>Development</span>
            <h3>Business Platform</h3>
          </div>
        </article>
      </div>
    </section>

    <section class="testimonial wrapper">
      <div class="play-badge">▶</div>
      <div class="testimonial-copy">
        <h2>I am Fully Committed <br />To The Needs My Customers</h2>
      </div>

      <div class="feedback-panel">
        <div class="rating">★★★★★</div>
        <p>
          “I recently hired Robert for a product redesign and was impressed by how carefully he listened,
          communicated, and delivered. The process was smooth from start to finish.”
        </p>
        <div class="feedback-author">
          <strong>Client Name</strong>
          <span>Founder</span>
        </div>
      </div>
    </section>

    <div class="stats-band">
      <div class="wrapper stats-grid">
        <div class="stat-item">
          <strong>234+</strong>
          <span>Completed Projects</span>
        </div>
        <div class="stat-item">
          <strong>40+</strong>
          <span>Happy Clients</span>
        </div>
        <div class="stat-item">
          <strong>4.9/5</strong>
          <span>Average Rating</span>
        </div>
        <div class="stat-item">
          <strong>23+</strong>
          <span>Years Experience</span>
        </div>
      </div>
    </div>

    <section class="faq-section wrapper" id="contact">
      <div class="faq-visual">
        <img src="/assets/profile.jpg" alt="Professional portrait" />
      </div>

      <div class="faq-copy">
        <p class="mini-label">Common Questions</p>
        <h2>General Questions</h2>

        <div class="faq-list">
          <details open>
            <summary>How do I get a website in 3 days?</summary>
            <p>We start with a short discovery call, define the scope, and move quickly on design and implementation.</p>
          </details>
          <details>
            <summary>Can you create amazing designs?</summary>
            <p>Yes — every layout is tailored to your goals, voice, and customer experience.</p>
          </details>
          <details>
            <summary>Where can I get support for my project?</summary>
            <p>Support is available through email, chat, and direct consultation throughout the build.</p>
          </details>
          <details>
            <summary>What are your working hours?</summary>
            <p>We work with flexible hours and can coordinate for your time zone and project sprint.</p>
          </details>
        </div>
      </div>
    </section>

    <section class="contact-cta wrapper">
      <div class="contact-text">
        <p class="mini-label">Contact Me</p>
        <h2>Have Any Project In Mind?</h2>
        <p>
          I design and build products that look sharp, work smoothly, and help your business reach the next level.
        </p>
      </div>

      <form class="mini-contact">
        <input type="text" placeholder="Your Name" />
        <input type="email" placeholder="Your Email" />
        <textarea rows="3" placeholder="Your Message"></textarea>
        <button type="submit">Send Message</button>
      </form>
    </section>

    </main>
</BaseLayout>

<style>
  .landing-page {
    background: #f9efe9;
    color: var(--gray-200);
    overflow-x: hidden;
  }

  .hero-section {
    padding: 2.5rem 0 1.25rem;
  }

  .hero-layout {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: 2.5rem;
    min-height: 36rem;
  }

  .eyebrow,
  .mini-label {
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    font-weight: 800;
    color: #8550c7;
    margin-bottom: 1rem;
  }

  .hero-copy h1 {
    font-size: clamp(3rem, 4.8vw, 4.7rem);
    line-height: 0.95;
    color: var(--gray-100);
    margin: 0;
    letter-spacing: -0.06em;
  }

  .hero-copy h1 span {
    display: block;
    color: var(--gray-100);
  }

  .tagline {
    max-width: 34rem;
    margin-top: 1.2rem;
    font-size: 1.06rem;
    line-height: 1.8;
    color: var(--gray-300);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .primary-btn,
  .secondary-btn,
  .mini-contact button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
    transition: transform 0.2s ease;
  }

  .primary-btn {
    background: linear-gradient(135deg, #f26363, #ef5d5d);
    color: white;
    padding: 1rem 1.5rem;
  }

  .secondary-btn {
    border: 1px solid rgba(98, 78, 113, 0.2);
    color: var(--gray-100);
    background: rgba(255,255,255,0.33);
    padding: 1rem 1.6rem;
  }

  .primary-btn:hover,
  .secondary-btn:hover,
  .mini-contact button:hover {
    transform: translateY(-1px);
  }

  .hero-visual {
    display: flex;
    justify-content: center;
  }

  .portrait-wrap {
    position: relative;
    width: min(30rem, 100%);
    padding: 1.15rem;
    border-radius: 2rem;
    background: linear-gradient(135deg, #a177ff, #7a5de8);
    transform: rotate(0deg);
    box-shadow: 0 28px 55px rgba(116, 87, 232, 0.22);
  }

  .portrait-wrap::before {
    content: "";
    position: absolute;
    inset: -16px 18px 14px -18px;
    border: 2px solid rgba(75, 62, 73, 0.5);
    border-radius: 2rem;
    z-index: -1;
  }

  .portrait-wrap img {
    display: block;
    width: 100%;
    border-radius: 1.3rem;
    object-fit: cover;
    min-height: 32rem;
  }

  .services-section {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.2rem;
    padding: 1.5rem 0 3rem;
  }

  .service-card {
    background: rgba(255,255,255,0.38);
    border: 1px solid rgba(74, 56, 76, 0.08);
    border-radius: 1.5rem;
    padding: 1.4rem 1.2rem;
    box-shadow: 0 22px 40px rgba(52, 38, 57, 0.04);
  }

  .service-card:nth-child(odd) {
    background: rgba(255, 255, 255, 0.54);
  }

  .service-icon {
    display: inline-flex;
    width: 2.8rem;
    height: 2.8rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.9rem;
    background: rgba(142, 108, 245, 0.12);
    color: #784ee3;
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .service-card h3 {
    font-size: 1.2rem;
    margin-bottom: 0.7rem;
    color: var(--gray-100);
    line-height: 1.2;
  }

  .service-card p {
    color: var(--gray-300);
    line-height: 1.7;
    font-size: 0.98rem;
  }

  .process-section {
    padding: 2.75rem 0 4rem;
  }

  .process-layout {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 2rem;
    align-items: center;
  }

  .process-photo {
    display: flex;
    justify-content: center;
  }

  .process-photo img {
    width: min(32rem, 100%);
    height: 31rem;
    object-fit: cover;
    border-radius: 2rem;
    border: 4px solid #8b66f3;
    box-shadow: 0 26px 50px rgba(79, 54, 108, 0.08);
  }

  .process-copy {
    display: grid;
    gap: 1.4rem;
  }

  .process-copy h2 {
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .process-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: start;
    background: rgba(255,255,255,0.42);
    border: 1px solid rgba(90, 73, 104, 0.08);
    border-radius: 1.2rem;
    padding: 1rem 1rem 1rem 0.8rem;
  }

  .percent {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 5rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: linear-gradient(135deg, #f7d1c9, #f7e1d9);
    color: var(--gray-100);
    font-weight: 800;
    font-size: 0.9rem;
  }

  .process-item h4 {
    margin: 0 0 0.35rem;
    color: var(--gray-100);
    font-size: 1.2rem;
  }

  .process-item p {
    color: var(--gray-300);
    line-height: 1.7;
  }

  .portfolio-section {
    padding: 1rem 0 4rem;
  }

  .section-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 2rem;
  }

  .section-header h2 {
    font-size: clamp(2.2rem, 4vw, 3.1rem);
    color: var(--gray-100);
    margin: 0;
  }

  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .portfolio-card {
    overflow: hidden;
    border-radius: 1.5rem;
    background: rgba(255,255,255,0.38);
    border: 1px solid rgba(90, 73, 104, 0.08);
    box-shadow: 0 24px 40px rgba(52, 38, 57, 0.04);
  }

  .portfolio-card {
    overflow: hidden;
    border-radius: 1.5rem;
    background: rgba(255,255,255,0.38);
    border: 1px solid rgba(90, 73, 104, 0.08);
    box-shadow: 0 24px 40px rgba(52, 38, 57, 0.04);
  }

  .card-feature {
    grid-column: span 2;
  }

  .portfolio-image {
    overflow: hidden;
  }

  .portfolio-image img {
    display: block;
    width: 100%;
    height: 23rem;
    object-fit: cover;
  }

  .card-feature .portfolio-image img {
    height: 26rem;
  }

  .card-meta {
    padding: 1rem 1rem 1.3rem;
  }

  .card-meta span {
    display: inline-block;
    margin-bottom: 0.5rem;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #8264e2;
    font-weight: 700;
  }

  .card-meta h3 {
    color: var(--gray-100);
    font-size: 1.4rem;
    margin: 0;
  }

  .testimonial {
    display: grid;
    grid-template-columns: 80px 1fr 1.2fr;
    align-items: center;
    gap: 1.5rem;
    padding: 2rem 0 3rem;
  }

  .feedback-panel {
    background: linear-gradient(135deg, #7d64f6, #5d44e9);
    color: rgba(255, 255, 255, 0.95);
    padding: 2rem 1.5rem;
    border-radius: 1.6rem;
    box-shadow: 0 24px 40px rgba(90, 68, 233, 0.18);
  }

  .play-badge {
    width: 5rem;
    height: 5rem;
    border-radius: 50%;
    background: linear-gradient(135deg, #f26767, #ec5959);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    box-shadow: 0 18px 32px rgba(242, 103, 103, 0.26);
  }

  .testimonial-copy h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.15;
    color: var(--gray-100);
  }

  .feedback-panel {
    background: linear-gradient(135deg, #7d64f6, #5d44e9);
    color: rgba(255, 255, 255, 0.95);
    padding: 2rem 1.5rem;
    border-radius: 1.6rem;
    box-shadow: 0 24px 40px rgba(90, 68, 233, 0.18);
  }

  .rating {
    letter-spacing: 0.2em;
    margin-bottom: 1rem;
    font-size: 0.85rem;
  }

  .feedback-panel p {
    color: rgba(255,255,255,0.9);
    line-height: 1.8;
    margin-bottom: 1rem;
  }

  .feedback-author {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-size: 0.86rem;
  }

  .stats-band {
    background: linear-gradient(135deg, #f87676, #ef5d5d);
    color: white;
    padding: 2rem 0;
    margin-top: 2rem;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .stat-item {
    display: grid;
    gap: 0.4rem;
    justify-items: center;
    text-align: center;
    opacity: 0.96;
  }

  .stat-item strong {
    font-size: clamp(2rem, 3vw, 2.8rem);
    font-weight: 800;
  }

  .stat-item span {
    font-size: 0.8rem;
    color: rgba(255,255,255,0.9);
  }

  .faq-section {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 2.2rem;
    align-items: center;
    padding: 4rem 0;
  }

  .faq-visual img {
    display: block;
    width: min(28rem, 100%);
    height: 27rem;
    object-fit: cover;
    border-radius: 2rem;
    border: 4px solid #8b66f3;
  }

  .faq-copy h2 {
    font-size: clamp(2.1rem, 4vw, 3rem);
    margin: 0 0 1.5rem;
    color: var(--gray-100);
  }

  .faq-list {
    display: grid;
    gap: 0.8rem;
  }

  .faq-list details {
    background: rgba(255,255,255,0.45);
    border: 1px solid rgba(90, 73, 104, 0.08);
    border-radius: 1rem;
    padding: 0.9rem 1rem;
  }

  .faq-list summary {
    cursor: pointer;
    list-style: none;
    font-weight: 700;
    color: var(--gray-100);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .faq-list summary::-webkit-details-marker {
    display: none;
  }

  .faq-list summary::after {
    content: "+";
    font-size: 1.3rem;
    color: var(--gray-200);
  }

  .faq-list details[open] summary::after {
    content: "−";
  }

  .faq-list p {
    margin-top: 0.7rem;
    color: var(--gray-300);
    line-height: 1.7;
  }

  .contact-cta {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 2.5rem;
    align-items: center;
    padding: 4rem 0 2rem;
  }

  .mini-contact {
    display: grid;
    gap: 1rem;
    background: rgba(255,255,255,0.44);
    border: 1px solid rgba(90, 73, 104, 0.08);
    border-radius: 1.6rem;
    padding: 1.5rem;
  }

  .contact-text h2 {
    font-size: clamp(2.1rem, 4vw, 3rem);
    margin: 0 0 0.8rem;
    color: var(--gray-100);
  }

  .contact-text p {
    color: var(--gray-300);
    line-height: 1.8;
  }

  .mini-contact {
    display: grid;
    gap: 1rem;
    background: rgba(255,255,255,0.44);
    border: 1px solid rgba(90, 73, 104, 0.08);
    border-radius: 1.6rem;
    padding: 1.5rem;
  }

  .mini-contact input,
  .mini-contact textarea {
    width: 100%;
    border: 1px solid rgba(83, 74, 96, 0.12);
    border-radius: 0.9rem;
    background: rgba(255,255,255,0.76);
    padding: 0.9rem 1rem;
    font: inherit;
    color: var(--gray-100);
  }

  .mini-contact input::placeholder,
  .mini-contact textarea::placeholder {
    color: #8f8f99;
  }

  .mini-contact button {
    justify-self: start;
    border: 0;
    background: linear-gradient(135deg, #f26767, #eb5757);
    color: white;
    padding: 0.9rem 1.5rem;
    cursor: pointer;
  }

  .blog-section {
    padding: 4rem 0 2rem;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.4rem;
  }

  .blog-card {
    background: rgba(255,255,255,0.38);
    border: 1px solid rgba(90, 73, 104, 0.08);
    border-radius: 1.5rem;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(52, 38, 57, 0.04);
  }

  .blog-card img {
    display: block;
    width: 100%;
    height: 16rem;
    object-fit: cover;
  }

  .blog-body {
    padding: 1rem 1rem 1.2rem;
  }

  .blog-date {
    color: #7c68ea;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
    margin-bottom: 0.7rem;
  }

  .blog-body h3 {
    color: var(--gray-100);
    font-size: 1.2rem;
    line-height: 1.5;
    margin-bottom: 0.8rem;
  }

  .blog-body a {
    color: #f05656;
    font-weight: 700;
    text-decoration: none;
  }

  @media (max-width: 50em) {
    .hero-layout,
    .process-layout,
    .faq-section,
    .contact-cta,
    .testimonial,
    .portfolio-grid,
    .blog-grid,
    .services-section,
    .stats-grid {
      grid-template-columns: 1fr;
    }

    .hero-layout {
      min-height: auto;
      padding-top: 1rem;
    }

    .services-section,
    .stats-grid,
    .blog-grid,
    .portfolio-grid {
      display: grid;
    }

    .card-feature {
      grid-column: auto;
    }

    .testimonial {
      display: block;
    }

    .play-badge {
      margin-bottom: 1rem;
    }

    .hero-copy h1 {
      max-width: 14ch;
    }

    .portrait-wrap img {
      min-height: 24rem;
    }

    .faq-visual img {
      width: 100%;
    }
  }
</style>
