<section class="projects" id="projects" data-reveal>
  <div class="container">
    <div class="projects__header">
      <div>
        <p class="label">Selected Work</p>
        <h2 class="projects__title">Six systems shipped. Three actively maintained.</h2>
        <p class="projects__subtitle">
          Logged the way I track in version control: client platforms, startup infrastructure, and independent tools.
        </p>
      </div>

      <!-- Category Filter Tabs powered by anime.js -->
      <div class="projects__filters" role="tablist" aria-label="Filter projects">
        <button class="filter-tab is-active" data-filter="all" type="button" data-hover>All (6)</button>
        <button class="filter-tab" data-filter="client" type="button" data-hover>Client Work (3)</button>
        <button class="filter-tab" data-filter="product" type="button" data-hover>Products (2)</button>
        <button class="filter-tab" data-filter="startup" type="button" data-hover>Startups (1)</button>
      </div>
    </div>

    <div class="projects__grid" id="projects-grid">
      {projects.map((p) => (
        <article class="project-card" data-category={p.category} data-hover data-cursor-shape="square" data-cursor-pad="4">
          <div class="project-card__top">
            <div class="project-card__meta-left">
              <span class="project-card__hash">{p.hash}</span>
              <span class="project-card__category">{p.categoryLabel}</span>
            </div>
            <span class={`project-card__status ${p.statusClass}`}>
              <span class="status-indicator"></span>
              <span>{p.status}</span>
            </span>
          </div>

          <div class="project-card__main">
            <div class="project-card__head">
              <h3 class="project-card__name">{p.name}</h3>
              <a href={p.href} target="_blank" rel="noopener noreferrer" class="project-card__link" aria-label={`Visit ${p.name}`} data-hover>
                <span>{p.linkLabel}</span>
                <span class="arrow-glyph">↗</span>
              </a>
            </div>

            <p class="project-card__role">{p.role}</p>

            <div class="project-card__highlight">
              <span class="project-card__highlight-dot">⚡</span>
              <span>{p.highlight}</span>
            </div>

            <p class="project-card__desc">{p.description}</p>
          </div>

          <div class="project-card__footer">
            <ul class="project-card__tags">
              {p.tags.map((tag) => <li class="project-card__tag-item">{tag}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
