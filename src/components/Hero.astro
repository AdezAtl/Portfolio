---
const logLines = [
  { date: '2026.08', text: 'resolved 51 merge-conflict files across jut-frontend, shipped clean' },
  { date: '2026.08', text: 'designed matog-consulting.site — full brand + build, Lagos/Warri/Asaba' },
  { date: '2026.07', text: 'connected custom domain, portfolio v3 live on vercel' },
  { date: '2026.06', text: 'unipulse: news + resource feed shipped to first testers' },
];
---

<section id="top" class="relative overflow-hidden px-6 pt-16 pb-20 md:px-10 md:pt-24 md:pb-28">
  <div class="mx-auto grid max-w-wrap gap-14 lg:grid-cols-[1.15fr_0.85fr] lg:gap-10">
    <div>
      <p class="reveal font-mono text-xs uppercase tracking-widest2 text-amber">
        Ibadan, Nigeria — CS, University of Ilorin
      </p>

      <h1 class="reveal mt-5 max-w-xl font-display text-[2.6rem] font-semibold leading-[1.05] tracking-tightest text-ink sm:text-6xl" style="--reveal-delay:80ms">
        I build the product.<br />
        Then I build the<br />
        company around it.
      </h1>

      <p class="reveal mt-6 max-w-md text-[17px] leading-relaxed text-ink-soft" style="--reveal-delay:160ms">
        Founder of UniPulse. Frontend and backend on JUT at Aoni. The person
        Ibadan businesses call when their site needs to actually work — not
        just look finished in a screenshot.
      </p>

      <div class="reveal mt-9 flex flex-wrap items-center gap-x-8 gap-y-3" style="--reveal-delay:240ms">
        <a href="#work" class="link-underline font-display text-base font-medium text-ink">
          View the work →
        </a>
      </div>
    </div>

    <div id="log" class="reveal self-end rounded-[4px] border border-line bg-[#EAE3D2] p-5 font-mono text-[12.5px] leading-relaxed text-ink-soft md:p-6" style="--reveal-delay:200ms">
      <p class="mb-3 text-ink"><span class="text-amber">abdullah@ibadan</span>:~$ <span class="text-ink">git log --oneline -4</span></p>
      {logLines.map((l) => (
        <p class="border-t border-dashed border-line py-2 first:border-t-0">
          <span class="text-moss">{l.date}</span> — {l.text}
        </p>
      ))}
      <p class="mt-3 text-ink-soft/70">// full history in <a href="#work" class="link-underline">selected work</a> below</p>
    </div>
  </div>
</section>
