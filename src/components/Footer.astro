---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <p class="footer__copy">© {year} Abdullah Adesomi. Built with Astro and anime.js.</p>
    <div class="footer__links">
      <a href="https://github.com/AdezAtl" target="_blank" rel="noopener noreferrer" data-hover>GitHub</a>
      <a href="mailto:adezatl4336@gmail.com" data-hover>Email</a>
      <a href="https://wa.me/2347012941798" target="_blank" rel="noopener noreferrer" data-hover>WhatsApp</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--c-border);
    padding-block: var(--sp-5);
  }

  .footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }

  .footer__copy {
    font: var(--t-small);
    color: var(--c-text-tertiary);
  }

  .footer__links {
    display: flex;
    gap: var(--sp-4);
  }

  .footer__links a {
    font: var(--t-small);
    color: var(--c-text-secondary);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .footer__links a:hover { color: var(--c-accent-bright); }
</style>
