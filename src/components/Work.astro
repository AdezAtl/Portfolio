---
const roles = [
  {
    period: '2024 — Present',
    role: 'Independent Web Engineer & Builder',
    org: 'Client Engagements',
    description:
      'Deliver custom web platforms and e-commerce architectures directly for commercial clients (including One Consulting and Lola’s Hub). Own the complete lifecycle from semantic frontend engineering and custom typography to API pipelines and production deployment.',
    tags: ['Astro', 'React', 'Tailwind CSS', 'TypeScript', 'Node.js', 'Vercel'],
  },
  {
    period: '2025 — Present',
    role: 'Frontend & Backend Developer',
    org: 'Aoni',
    description:
      'Work across the full stack of JUT, an on-demand home services marketplace. Own booking-flow features end to end — UI, API routes, provider onboarding, and the Prisma/PostgreSQL layer behind them — plus transactional email delivery.',
    tags: ['React Native', 'Expo', 'Next.js', 'Prisma', 'PostgreSQL'],
  },
  {
    period: '2024 — Present',
    role: 'Founder & Full-Stack Engineer',
    org: 'UniPulse',
    description:
      'Built a campus information and resource-sharing platform from the ground up for University of Ilorin students. Designed schema models, real-time feeds, and deployed the production system solo.',
    tags: ['React', 'Astro', 'PostgreSQL', 'Supabase'],
  },
];
---

<section class="work" id="work" data-reveal>
  <div class="container">
    <div class="work__header">
      <p class="label">Experience</p>
      <h2 class="work__title">Commercial delivery, startup engineering &amp; founder scope.</h2>
    </div>

    <ul class="work__list">
      {roles.map((r) => (
        <li class="work__item" data-hover data-cursor-shape="square" data-cursor-pad="4">
          <span class="work__period">{r.period}</span>
          <div class="work__body">
            <h3 class="work__role">{r.role} <span class="work__org">— {r.org}</span></h3>
            <p class="work__desc">{r.description}</p>
            <ul class="work__tags">
              {r.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .work {
    padding-block: var(--sp-8);
    border-top: 1px solid var(--c-border);
  }

  .work__header {
    max-width: 60ch;
  }

  .work__title {
    font: var(--t-h1);
    color: var(--c-text-primary);
    margin-top: var(--sp-2);
    letter-spacing: -0.015em;
  }

  .work__list {
    list-style: none;
    margin: var(--sp-6) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .work__item {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: var(--sp-6);
    padding: var(--sp-5);
    border-top: 1px solid var(--c-border);
    border-radius: var(--r-md);
    transition: background 150ms ease, border-color 150ms ease;
  }

  .work__item:hover {
    background: var(--c-bg-raised);
  }

  .work__item:first-child { border-top: 1px solid var(--c-border); }

  .work__period {
    font: var(--t-label);
    font-size: 0.775rem;
    color: var(--c-text-tertiary);
    padding-top: var(--sp-1);
  }

  .work__role {
    font: var(--t-h3);
    color: var(--c-text-primary);
    margin: 0;
  }

  .work__org {
    font-weight: 400;
    color: var(--c-text-secondary);
  }

  .work__desc {
    margin-top: var(--sp-3);
    font: var(--t-body);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--c-text-secondary);
    max-width: 62ch;
  }

  .work__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin: var(--sp-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .work__tags li {
    font: var(--t-label);
    font-size: 0.725rem;
    color: var(--c-accent);
    background: var(--c-accent-wash);
    border: 1px solid rgba(79, 184, 201, 0.15);
    border-radius: var(--r-sm);
    padding: 2px 8px;
  }

  @media (max-width: 720px) {
    .work__item {
      grid-template-columns: 1fr;
      gap: var(--sp-2);
      padding: var(--sp-4) 0;
    }
  }
</style>
